{
  "scriptFile": "main.py",

  "bindings": [
    {
      "type": "queueTrigger",
      "direction": "in",
      "name": "msg_snake",
      "queueName": "testqueue",
      "connection": "AzureWebJobsStorage",
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "$return",
      "connection": "AzureWebJobsStorage",
      "path": "python-worker-tests/test-queue-blob.txt"
    }
  ]
}
