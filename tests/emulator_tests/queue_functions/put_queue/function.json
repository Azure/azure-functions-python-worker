{
  "scriptFile": "main.py",

  "bindings": [
    {
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "authLevel": "anonymous"
    },
    {
      "direction": "out",
      "name": "msg_snake",
      "queueName": "testqueue",
      "connection": "AzureWebJobsStorage",
      "type": "queue"
    },
    {
      "direction": "out",
      "name": "$return",
      "type": "http"
    }
  ]
}
