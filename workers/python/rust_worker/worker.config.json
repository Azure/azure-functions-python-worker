{
    "description": {
        "language": "python",
        "defaultRuntimeVersion": "3.14",
        "supportedRuntimeVersions": ["3.14"],
        "supportedOperatingSystems": ["LINUX"],
        "supportedArchitectures": ["X64"],
        "extensions": [".py"],
        "defaultExecutablePath": "%FUNCTIONS_WORKER_RUNTIME_VERSION%/{os}/{architecture}/rust_worker",
        "defaultWorkerPath": "%FUNCTIONS_WORKER_RUNTIME_VERSION%/{os}/{architecture}/noop.txt",
        "workerIndexing": "true"
    },
    "processOptions": {
        "initializationTimeout": "00:02:00",
        "environmentReloadTimeout": "00:02:00"
    }
}
