{
  "scriptFile": "__init__.py",

  "bindings": [
    {
      "type": "serviceBusTrigger",
      "direction": "in",
      "name": "msg_snake",
      "queueName": "testqueue",
      "connection": "AzureWebJobsServiceBusConnectionString",
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "$return",
      "connection": "AzureWebJobsStorage",
      "path": "python-worker-tests/test-servicebus-triggered.txt"
    }
  ]
}
