{
  "scriptFile": "__init__.py",

  "bindings": [
    {
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "authLevel": "anonymous"
    },
    {
      "direction": "in",
      "type": "cosmosDB",
      "name": "docs_snake",
      "databaseName": "test",
      "containerName": "items",
      "id": "cosmosdb-input-test",
      "leaseContainerName": "leases",
      "connection": "AzureWebJobsCosmosDBConnectionString",
      "createLeaseContainerIfNotExists": true
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}
