<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Microsoft.Azure.Functions.RustPythonWorker</id>
    <version>0.1.0</version>
    <authors>Microsoft</authors>
    <owners>Microsoft</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Microsoft Azure Functions Rust Python Worker (Python 3.14+, Linux/X64)</description>
    <copyright>© .NET Foundation. All rights reserved.</copyright>
  </metadata>
  <files>
    <!-- Native binary + bridge + v2 runtime, per version/os/arch.
         The Rust worker embeds one CPython ABI, so it is Linux/X64/3.14 only today. -->
    <file src="..\..\3.14_RUST_LINUX_X64\**" target="tools\3.14\LINUX\X64" />
    <!-- Host registration (self-locating; templated executable/worker paths). -->
    <file src="..\..\workers\python\rust_worker\worker.config.json" target="tools" />
    <file src="Microsoft.Azure.Functions.PythonWorker.targets" target="build" />
    <file src="..\..\_manifest\spdx_2.2\manifest.spdx.json" target="SBOM\manifest.spdx.json" />
  </files>
</package>
